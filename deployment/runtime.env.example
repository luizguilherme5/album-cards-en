# Save a copy as ~/.config/album-cards/runtime.env on your Linux player.
# Values use shell syntax; quote values containing spaces.
SPOTIFY_NAME="Album Cards"
# Find stable ALSA card names with aplay -l. Test your own device first.
SPOTIFY_ALSA_DEVICE="default"
SPOTIFY_AUDIO_FORMAT="S16"
# Optional: both Caldera and Spotify share ONE exclusive USB output.
# Requires an existing Caldera user service and the Spotify service installed here.
# ALBUM_CARDS_AUDIO_HANDOFF=1
# CALDERA_SERVICE="caldera-music.service"
